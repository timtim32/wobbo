*.bun-build

# Wobbo app builds (tools/release.sh)
/build/

# Personal AI tooling: each developer sets these up locally (docs/DEVELOPMENT.md)
/.claude/
/.agents/
/.mcp.json
/CLAUDE.md
/AGENTS.md
